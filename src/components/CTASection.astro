---
const { heading = 'Ready to plan your Kansas City deck project?', text = 'Request a free estimate and ask about project options for your space, material preferences, and timeline.' } = Astro.props;
---

<section class="bg-moss px-5 py-16 text-white sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl rounded-b-lg bg-white px-6 py-12 text-center text-ink shadow-glow sm:px-10 lg:px-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">DecksRXKC</p>
      <h2 class="mt-3 font-display text-3xl font-black leading-[1.06] text-moss sm:text-4xl lg:text-5xl">{heading}</h2>
      <p class="mt-4 text-lg leading-8 text-ink/70">{text}</p>
    </div>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a class="btn btn-primary" href="/contact/">Request a Free Deck Estimate</a>
      <a class="btn btn-outline" href="/gallery/">View Gallery</a>
    </div>
  </div>
</section>
