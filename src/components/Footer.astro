---
import { business } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';
const year = new Date().getFullYear();
---

<footer class="bg-moss text-white">
  <div class="container grid gap-12 py-20 lg:grid-cols-[1.25fr_2fr]">
    <div>
      <a href="/" class="block max-w-[260px]" aria-label="DecksRXKC home">
        <img src={business.logo} alt="DecksRXKC" width="1222" height="390" loading="lazy" decoding="async" />
      </a>
      <p class="mt-6 max-w-md text-lg leading-8 text-white/70">Kansas City deck builder for custom decks, deck replacement, composite decking, wood decks, repairs, railings, stairs, and outdoor living upgrades.</p>
      <address class="mt-8 grid gap-1 not-italic text-white/78">
        {business.address}<br />
        <a class="hover:text-white" href={business.phoneHref}>{business.phone}</a><br />
        <a class="hover:text-white" href={`mailto:${business.email}`}>{business.email}</a>
      </address>
      <a class="mt-8 inline-flex min-h-14 items-center justify-center rounded-lg border border-white/35 px-8 text-base font-black text-white transition hover:bg-white hover:text-moss" href="/contact/">Schedule a Call</a>
    </div>
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h2 class="text-2xl font-black text-white/80">Services</h2>
        <ul class="mt-5 space-y-3 text-base text-white/65">
          {services.map((service) => <li><a class="hover:text-white" href={`/services/${service.slug}/`}>{service.shortName}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-black text-white/80">Service Areas</h2>
        <ul class="mt-5 space-y-3 text-base text-white/65">
          {areas.slice(0, 8).map((area) => <li><a class="hover:text-white" href={`/service-areas/${area.slug}/`}>{area.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-black text-white/80">Quick Links</h2>
        <ul class="mt-5 space-y-3 text-base text-white/65">
          <li><a class="hover:text-white" href="/about/">About</a></li>
          <li><a class="hover:text-white" href="/gallery/">Gallery</a></li>
          <li><a class="hover:text-white" href="/contact/">Contact</a></li>
          <li><a class="hover:text-white" href="/privacy-policy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 py-5">
    <div class="container flex flex-col gap-2 text-sm text-white/60 lg:flex-row lg:items-center lg:justify-between">
      <p>&copy; {year} DecksRXKC. All rights reserved.</p>
      <p>
        Website Designed by
        <a class="font-bold text-white/80 transition hover:text-white" href="https://hometownkc.agency" target="_blank" rel="noopener noreferrer">Hometown Marketing Agency</a>
      </p>
      <p>Serving the Kansas City Metro and surrounding areas.</p>
    </div>
  </div>
</footer>
