---
import { business, projectTypes, timelines } from '../data/site';
const { heading = 'Request a Free Deck Estimate', compact = false } = Astro.props;
const fieldClass = 'mt-2 min-h-12 w-full rounded-lg border border-moss/20 bg-white px-4 text-base text-charcoal shadow-sm transition placeholder:text-ink/40 hover:border-moss/30 focus:border-moss';
const labelClass = 'block text-sm font-black text-moss';
---

<section class={compact ? '' : 'scroll-mt-[var(--header-height)] bg-[radial-gradient(circle_at_center,rgba(59,86,159,0.32),rgba(27,36,79,0.96)_48%,#101522_100%)] py-10 sm:py-14'} id="estimate">
  <div class={compact ? '' : 'container'}>
    <div class={compact ? 'rounded-lg bg-white p-5 shadow-soft ring-1 ring-black/5 sm:p-7' : 'mx-auto max-w-4xl rounded-lg bg-white p-5 shadow-glow ring-1 ring-black/5 sm:p-8 lg:p-10'}>
      <div class="grid gap-5 border-b border-moss/10 pb-6 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow">Free Estimate</p>
          <h2 class="mt-2 font-display text-3xl font-black leading-[1.06] text-moss sm:text-4xl">{heading}</h2>
          <p class="mt-3 max-w-2xl text-base leading-7 text-ink/70">Name, phone, and city are enough to get started. Add project details if you have them.</p>
        </div>
        <a class="inline-flex min-h-11 items-center justify-center rounded-lg border border-moss/20 px-5 text-sm font-black text-moss transition hover:bg-moss hover:text-white" href={business.phoneHref}>
          Call {business.phone}
        </a>
      </div>

      <form class="mt-6 grid gap-5" name="deck-estimate" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="deck-estimate" />
        <p class="hidden"><label>Do not fill this out <input name="bot-field" /></label></p>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class={labelClass} for="estimate-name">
            Name
            <input id="estimate-name" class={fieldClass} name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label class={labelClass} for="estimate-phone">
            Phone
            <input id="estimate-phone" class={fieldClass} name="phone" type="tel" autocomplete="tel" placeholder="(913) 555-0199" required />
          </label>
          <label class={labelClass} for="estimate-email">
            Email <span class="font-semibold text-ink/50">(optional)</span>
            <input id="estimate-email" class={fieldClass} name="email" type="email" autocomplete="email" placeholder="you@example.com" />
          </label>
          <label class={labelClass} for="estimate-city">
            City
            <input id="estimate-city" class={fieldClass} name="city" autocomplete="address-level2" placeholder="Overland Park" required />
          </label>
          <label class={labelClass} for="estimate-project-type">
            Project type <span class="font-semibold text-ink/50">(optional)</span>
            <select id="estimate-project-type" class={fieldClass} name="projectType">
              <option value="Not sure yet">Not sure yet</option>
              {projectTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </label>
          <label class={labelClass} for="estimate-timeline">
            Timeline <span class="font-semibold text-ink/50">(optional)</span>
            <select id="estimate-timeline" class={fieldClass} name="timeline">
              <option value="Flexible">Flexible</option>
              {timelines.map((timeline) => <option value={timeline}>{timeline}</option>)}
            </select>
          </label>
        </div>

        <label class={labelClass} for="estimate-message">
          Project notes <span class="font-semibold text-ink/50">(optional)</span>
          <textarea id="estimate-message" class={`${fieldClass} min-h-28 py-3`} name="message" placeholder="Tell us what you want built, repaired, or replaced."></textarea>
        </label>

        <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
          <p class="text-sm text-ink/60">Required: name, phone, and city.</p>
          <button class="btn btn-primary min-h-14 px-10 text-base" type="submit">Send Request</button>
        </div>
      </form>
    </div>
  </div>
</section>
