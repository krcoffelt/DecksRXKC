---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import FAQ from '../../components/FAQ.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import CTASection from '../../components/CTASection.astro';
import { areas } from '../../data/areas';
import { services } from '../../data/services';
import { areaServiceSchema, faqSchema, breadcrumbSchema } from '../../data/schema';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const nearby = areas.filter((item) => item.slug !== area.slug).slice(0, 8);
const priorityServiceSlugs = ['custom-deck-building', 'deck-replacement', 'deck-repair', 'composite-decks', 'covered-decks', 'screened-in-porches', 'railings-stairs', 'outdoor-living-upgrades'];
const localServices = priorityServiceSlugs.map((slug) => services.find((service) => service.slug === slug)).filter(Boolean);
const faqs = [
  [`Do you build decks in ${area.name}?`, `Yes. DecksRXKC serves ${area.name} with custom deck building, composite decking, wood decks, covered decks, screened porches, repairs, replacement, railings, and stairs.`],
  [`What deck services are most common in ${area.name}?`, `Common ${area.name} requests include deck replacement, composite decking, deck repair, railing upgrades, stair changes, covered decks, and screened porch planning.`],
  [`Can DecksRXKC help decide between deck repair and replacement?`, `Yes. We can review visible wear, surface boards, stairs, railings, layout, and long-term goals so you can compare repair, resurfacing, and full replacement options.`],
  [`Do you build composite decks in ${area.name}?`, `Yes. Composite decking is a common option for homeowners who want lower maintenance, cleaner trim details, and consistent deck board appearance.`],
  [`Can you add a covered deck or screened porch?`, `Covered and screened projects depend on structure, roof connection, openings, and local requirements. The estimate process can help determine the right scope.`],
  [`Do permits apply in ${area.name}?`, `Permit requirements vary by city and project scope. Homeowners should verify local rules or review likely requirements during the estimate process.`]
];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Service Areas', href: '/service-areas/' }, { label: area.name, href: `/service-areas/${area.slug}/` }];
---

<BaseLayout title={area.title} description={area.description} schemas={[areaServiceSchema(area), faqSchema(faqs), breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <section class="page-hero">
    <img class="page-hero-media" src="/images/kansas-city-elevated-composite-deck-cable-railing-stairs.png" alt={`Deck builder project serving ${area.name}`} width="1662" height="1246" />
    <div class="page-hero-shade"></div>
    <div class="page-hero-inner">
      <p class="eyebrow eyebrow-on-dark">Local Deck Contractor</p>
      <h1 class="page-title">{area.h1}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-white/80 sm:text-xl">{area.intro}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="btn btn-primary" href="#estimate">Request a Free Deck Estimate</a>
        <a class="btn btn-secondary" href="/services/">View Deck Services</a>
      </div>
      <div class="mt-8 flex max-w-4xl flex-wrap gap-2">
        {area.keywordFocus.map((keyword) => <span class="rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.12em] text-white/72">{keyword}</span>)}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <div>
        <p class="eyebrow">Decks in {area.name}</p>
        <h2 class="section-title mt-3">Built around {area.city} homes and backyards.</h2>
        <p class="lead mt-5">{area.focus}. The right plan depends on the existing structure, access, material expectations, railing needs, and how the outdoor space should work every week.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {area.localNotes.map((note) => (
          <div class="rounded-lg border border-moss/10 bg-cream p-5">
            <p class="font-black text-moss">{note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-[0.36fr_0.64fr] lg:items-end">
        <div>
          <p class="eyebrow">Local Services</p>
          <h2 class="section-title mt-3">Deck services homeowners search for in {area.name}.</h2>
        </div>
        <p class="lead">Each service page supports the location page with deeper detail, while this page keeps the local context clear for {area.city} homeowners.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {localServices.map((service) => (
          <a class="group rounded-lg border border-moss/10 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-moss/20 hover:shadow-soft" href={`/services/${service.slug}/`}>
            <span class="text-xs font-black uppercase tracking-[0.18em] text-bronze">{area.city}</span>
            <h3 class="mt-2 font-display text-2xl font-black leading-tight text-moss">{service.name}</h3>
            <p class="mt-3 text-sm leading-7 text-ink/68">{service.description.replace('in Kansas City', `in ${area.name}`)}</p>
            <span class="mt-4 inline-block text-sm font-black text-moss transition group-hover:text-bronze">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="eyebrow">Repair, Replace, Rebuild</p>
        <h2 class="section-title mt-3">A practical estimate for the actual deck you have.</h2>
      </div>
      <div class="prose-copy">
        <p>Some {area.name} projects start as deck repair calls and become replacement conversations once stairs, railings, framing, or the deck surface are reviewed. Others only need a focused repair, railing upgrade, or material refresh.</p>
        <p>DecksRXKC keeps the estimate process centered on useful decisions: what can stay, what should change, whether composite or wood makes sense, and how the finished deck should connect to the home and yard.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <p class="eyebrow">Gallery Preview</p>
      <h2 class="section-title mt-3">Deck project inspiration near {area.name}.</h2>
      <div class="mt-10"><GalleryGrid limit={6} /></div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div><p class="eyebrow">FAQ</p><h2 class="section-title mt-3">{area.name} deck questions.</h2></div>
      <FAQ faqs={faqs} />
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container">
      <p class="eyebrow">Nearby Service Areas</p>
      <h2 class="section-title mt-3">Deck services across the Kansas City metro.</h2>
      <div class="mt-8 flex flex-wrap gap-2">
        {nearby.map((near) => <a class="rounded-full border border-charcoal/10 bg-white px-4 py-2 text-sm font-bold hover:border-moss hover:bg-moss hover:text-white" href={`/service-areas/${near.slug}/`}>{near.name}</a>)}
      </div>
    </div>
  </section>

  <LeadForm heading={`Request a Free Deck Estimate in ${area.name}`} />
  <CTASection heading={`Planning a deck project in ${area.name}?`} />
</BaseLayout>
