---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadForm from '../../components/LeadForm.astro';
import CTASection from '../../components/CTASection.astro';
import { areas } from '../../data/areas';
import { services } from '../../data/services';
import { keywordTargets } from '../../data/seo';
import { breadcrumbSchema } from '../../data/schema';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Service Areas', href: '/service-areas/' }];
const locationKeywords = keywordTargets.filter((target) => target.intent === 'location');
const serviceKeywords = keywordTargets.filter((target) => target.intent !== 'location').slice(0, 31);
---

<BaseLayout title="Kansas City Deck Builder Service Areas | Local Deck Contractor | DecksRXKC" description="DecksRXKC serves Kansas City, Overland Park, Olathe, Lenexa, Shawnee, Leawood, Lee’s Summit, Blue Springs, Liberty, Parkville, and nearby areas." schemas={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <section class="section bg-cream pt-8">
    <div class="container grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div>
      <p class="eyebrow">Service Areas</p>
      <h1 class="section-title mt-3">Kansas City deck builder serving both sides of the metro.</h1>
      <p class="lead mt-5 max-w-3xl">Custom deck building, deck repair, deck replacement, composite decking, covered decks, screened porches, railings, stairs, and outdoor living upgrades throughout the Kansas City metro.</p>
      </div>
      <div class="grid gap-x-8 border-y border-charcoal/10 sm:grid-cols-2">
        {areas.map((area) => <a class="border-b border-charcoal/10 py-4 transition hover:pl-2 hover:text-moss" href={`/service-areas/${area.slug}/`}><h2 class="font-display text-xl font-black text-charcoal">{area.name}</h2></a>)}
      </div>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container">
      <p class="eyebrow">Available Services</p>
      <h2 class="section-title mt-3">Deck services near you.</h2>
      <div class="mt-8 flex flex-wrap gap-3">{services.map((service) => <a class="rounded-full border border-charcoal/10 px-5 py-3 font-bold hover:border-moss hover:bg-moss hover:text-white" href={`/services/${service.slug}/`}>{service.name}</a>)}</div>
    </div>
  </section>
  <section class="section bg-cream">
    <div class="container grid gap-10 lg:grid-cols-[0.45fr_0.55fr]">
      <div>
        <p class="eyebrow">SEO Focus</p>
        <h2 class="section-title mt-3">50 deck keywords mapped to pages.</h2>
        <p class="lead mt-5">These targets guide page titles, headings, internal links, and location content without stuffing repeated phrases into every page.</p>
      </div>
      <div class="grid gap-8">
        <div>
          <h3 class="font-display text-2xl font-black text-moss">Core and service keywords</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {serviceKeywords.map((target) => <a class="rounded-full border border-moss/10 bg-white px-4 py-2 text-sm font-bold text-moss hover:border-moss hover:bg-moss hover:text-white" href={target.page}>{target.keyword}</a>)}
          </div>
        </div>
        <div>
          <h3 class="font-display text-2xl font-black text-moss">Location keywords</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {locationKeywords.map((target) => <a class="rounded-full border border-moss/10 bg-white px-4 py-2 text-sm font-bold text-moss hover:border-moss hover:bg-moss hover:text-white" href={target.page}>{target.keyword}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  <LeadForm />
  <CTASection />
</BaseLayout>
